NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb://localhost:27017/stayhive
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_characters_long_12345678
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_long_12345678
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_key
CLOUDINARY_API_SECRET=test_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@stayhive.com

CLIENT_URL=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

LOG_LEVEL=info

